{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skerry",
  "version": "0.1.0",
  "identifier": "com.skerry.workbench",
  "build": {
    "beforeDevCommand": "node scripts/prepare-desktop.mjs",
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
